<?xml version="1.0" encoding="utf-8"?>
<!-- The 1920x1080 design, halved: the TV runs at 320 dpi, so 1dp is 2 pixels. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1830">

    <ImageView
        android:id="@+id/photo_back"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/photo_front"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/scrim_top"
        android:layout_width="match_parent"
        android:layout_height="151dp"
        android:alpha="0.6"
        android:background="@drawable/scrim_top" />

    <View
        android:layout_width="match_parent"
        android:layout_height="270dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom" />

    <TextClock
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="46dp"
        android:layout_marginTop="25dp"
        android:fontFamily="sans-serif-light"
        android:format12Hour="HH:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:letterSpacing="-0.02"
        android:shadowColor="#59000000"
        android:shadowRadius="12"
        android:textColor="#FFFFFF"
        android:textSize="54sp" />

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="50dp"
        android:layout_marginTop="89dp"
        android:alpha="0.88"
        android:format12Hour="EEEE, MMMM d"
        android:format24Hour="EEEE, MMMM d"
        android:shadowColor="#73000000"
        android:shadowRadius="6"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/chips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="37dp"
        android:layout_marginEnd="48dp"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/credit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="122dp"
        android:ellipsize="end"
        android:maxWidth="490dp"
        android:shadowColor="#A6000000"
        android:shadowRadius="10"
        android:singleLine="true"
        android:textColor="#BDFFFFFF"
        android:textSize="10sp" />

    <HorizontalScrollView
        android:id="@+id/row_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="43dp"
        android:paddingTop="12dp"
        android:paddingEnd="43dp"
        android:paddingBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <FrameLayout
        android:id="@+id/all"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF060810"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginTop="33dp"
            android:fontFamily="sans-serif-light"
            android:text="All apps"
            android:textColor="#FFFFFF"
            android:textSize="30sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="43dp"
            android:layout_marginEnd="48dp"
            android:text="OK shows or hides an app · Back closes"
            android:textColor="#B8FFFFFF"
            android:textSize="12sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="92dp"
            android:clipToPadding="false"
            android:paddingStart="43dp"
            android:paddingTop="6dp"
            android:paddingEnd="43dp"
            android:paddingBottom="27dp"
            android:scrollbars="none">

            <GridLayout
                android:id="@+id/grid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:columnCount="7" />
        </ScrollView>
    </FrameLayout>

    <TextView
        android:id="@+id/toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="43dp"
        android:alpha="0"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />
</FrameLayout>
